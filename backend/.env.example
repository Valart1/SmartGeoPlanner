# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=smartgeoplanner

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3000
NODE_ENV=development

# Email / SMTP (for account verification emails)
# Leave SMTP_HOST empty (or MAIL_MODE=dev) to run in DEV mode — the
# verification code is printed to the backend console instead of emailed.
MAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=latizylfiu@gmail.com
SMTP_PASS=egdh ukpn yshy joef
MAIL_FROM=Smart Geo-Planner <latizylfiu@gmail.com>
ADMIN_EMAILS=latizylfiu@gmail.com

# Public base URL for verification links (use your LAN IP so phones can open them)
APP_PUBLIC_BASE_URL=http://192.168.1.90:3000
